{
  "name": "@mimir/unpacker",
  "version": "0.1.0",
  "private": true,
  "description": "A generic C64 PRG unpacker: runs the packed program in an emulated C64 and saves it when the unpacked program starts.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "unpack": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
