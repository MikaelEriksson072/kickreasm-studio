{
  "name": "@kickreasm/cli",
  "version": "1.0.0",
  "private": true,
  "description": "kickreasm analyse | export | verify — batch and CI front end for @kickreasm/core.",
  "type": "module",
  "bin": {
    "kickreasm": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kickreasm/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
