{
  "name": "mimir-studio",
  "private": true,
  "description": "Re-assemble Commodore 64 PRG files into clean, byte-exact Kick Assembler projects.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mimir/desktop dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "mimir": "pnpm --filter @mimir/cli start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
