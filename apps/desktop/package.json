{
  "name": "@kickreasm/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "KickReasm Studio — Electron desktop IDE for re-assembling C64 PRG files into Kick Assembler projects.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/silkscreen": "^5.2.0",
    "@kickreasm/core": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "comlink": "^4.4.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "immer": "^10.2.0",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.2",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "zustand": "^4.5.7"
  }
}
